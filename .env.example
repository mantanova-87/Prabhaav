# ==============================================================================
# PRABHAAV Platform - Environment Configuration
# ==============================================================================

# ─── FRONTEND CONFIG ──────────────────────────────────────────────────────────

# Important: Variables must start with VITE_ to be exposed to the React frontend

# Automatically set by Vercel to true during build/deployment
# Used by the frontend to detect if running in production
VITE_VERCEL=true

# (Optional) Base URL for API calls. If omitted, frontend defaults to `/api`
# For local dev: http://localhost:3001
VITE_API_URL=


# ─── BACKEND CONFIG ───────────────────────────────────────────────────────────

# Secret key for signing JWT tokens. Change this in production!
JWT_SECRET=prabhaav-secret-key-2024-mining-surveillance

# Environment type (development | production)
NODE_ENV=production
